              "/25": "255.255.255.128",
              "/26": "255.255.255.192",
              "/27": "255.255.255.224",
              "/28": "255.255.255.240"
            }
          },
          "instructions": "Vælg et prefix fra listen og returnér spørgsmål, hints, rubric og korrekt maske."
        },
        {
          "template_id": "cidr-host-count",
          "type": "short_answer",
          "description": "Beregn antal brugbare værter ud fra prefix.",
          "variables": {
            "prefix": ["/24", "/25", "/26", "/27"],
            "host_count": {
              "/24": 254,
              "/25": 126,
              "/26": 62,
              "/27": 30
            }
          }
        }
      ],
      "2": [
        {
          "template_id": "cidr-range",
          "type": "multi_step",
